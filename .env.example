# Konfigurasi Opsional KarirAI (Rust + Google Firebase)
# Salin ke `.env` bila ingin menghubungkan ke proyek Google Firebase Cloud produksi.
# Tanpa file `.env`, aplikasi otomatis berjalan lancar menggunakan Local Mirror
# atau otomatis mendeteksi Firebase Emulator lokal (:8080 / :9099)!

PORT=3000
FIREBASE_PROJECT_ID=demo-karir-ai
FIREBASE_API_KEY=demo-karir-ai-key

# Aktifkan baris di bawah bila menjalankan Firebase Emulator secara manual:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8088
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9098
